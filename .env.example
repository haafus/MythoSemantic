# All variables are optional — defaults work out of the box.
# Reads from .env or config/.env

# --- Paths (relative to project root or absolute) ---
# MYTHO_CORPUS_DIR=outputs/corpus
# MYTHO_CHROMA_DIR=outputs/chroma_db
# MYTHO_ANALYSIS_DIR=outputs/analysis
# MYTHO_LOGS_DIR=outputs/logs
# MYTHO_GRAPHS_DIR=outputs/graphs

# --- LLM (alias from config/models.json) ---
# MYTHO_LLM__MODEL=gpt4o-mini
# MYTHO_LLM__TEMPERATURE=0.1
# MYTHO_LLM__MAX_RETRIES=5

# --- Embeddings ---
# MYTHO_EMBEDDING__DEFAULT_CHUNKING=paragraph

# --- Server ---
# MYTHO_SERVER__HOST=127.0.0.1
# MYTHO_SERVER__PORT=8000

# --- Logging ---
# MYTHO_LOG_LEVEL=INFO

# --- API keys (read by SDKs / model_registry, not by pydantic-settings) ---
# OPENAI_API_KEY=sk-...
# GEMINI_API_KEY=AIza...
# DEEPSEEK_API_KEY=sk-...
# HF_TOKEN=hf_...
