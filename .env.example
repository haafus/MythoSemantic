# All variables are optional — defaults work out of the box.
# Prefix: MYTHO_

# --- Paths (relative to project root or absolute) ---
# MYTHO_CORPUS_DIR=outputs/corpus
# MYTHO_CORPUS_CHUNKED_DIR=outputs/corpus_chunked
# MYTHO_CHROMA_DIR=outputs/chroma_db
# MYTHO_CACHE_DIR=outputs/cache
# MYTHO_ANALYSIS_DIR=outputs/analysis
# MYTHO_LOGS_DIR=outputs/logs
# MYTHO_GRAPHS_DIR=outputs/graphs

# --- Embeddings ---
# MYTHO_DEFAULT_EMBEDDING_MODEL=BAAI/bge-m3
# MYTHO_DEFAULT_CHUNKING=paragraph
# HF_TOKEN=hf_...

# --- LLM (for graph generation and motif analysis) ---
# OPENAI_API_KEY=sk-...
# MYTHO_GRAPHS__BASE_URL=https://api.openai.com/v1
# MYTHO_GRAPHS__MODEL_NAME=gpt-4o-mini

# --- Logging ---
# MYTHO_LOG_LEVEL=INFO
